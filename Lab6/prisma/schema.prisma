generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // URL тепер не потрібен тут у Prisma 7.x, він береться з prisma.config.ts
}

// 1. Користувачі (додано поле is_pro для виконання умови Лаби 6)
model users {
  user_id    Int        @id @default(autoincrement())
  nickname   String     @unique @db.VarChar(50)
  email      String     @unique @db.VarChar(100)
  password   String     @db.VarChar(255)
  is_pro     Boolean    @default(false) 
  created_at DateTime   @default(now()) @db.Timestamp(6)
  posts      posts[]
  comments   comments[]
}

// 2. Пости (додано зв'язок reviews)
model posts {
  post_id    Int          @id @default(autoincrement())
  user_id    Int
  title      String       @db.VarChar(200)
  content    String
  created_at DateTime     @default(now()) @db.Timestamp(6)
  comments   comments[]
  post_tags  post_tags[]
  reviews    GameReview[] 
  users      users        @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

// 3. НОВА ТАБЛИЦЯ: Відгуки (вимога Лаби 6)
model GameReview {
  review_id Int     @id @default(autoincrement())
  rating    Int
  comment   String?
  post_id   Int
  post      posts   @relation(fields: [post_id], references: [post_id], onDelete: Cascade)
}

// 4. Коментарі
model comments {
  comment_id   Int      @id @default(autoincrement())
  post_id      Int
  user_id      Int
  comment_text String
  created_at   DateTime @default(now()) @db.Timestamp(6)
  users        users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  posts        posts    @relation(fields: [post_id], references: [post_id], onDelete: Cascade)
}

// 5. Теги
model tags {
  tag_id    Int         @id @default(autoincrement())
  tag_name  String      @unique @db.VarChar(50)
  post_tags post_tags[]
}

// 6. Зв'язок Пости-Теги (Many-to-Many)
model post_tags {
  post_id Int
  tag_id  Int
  posts   posts @relation(fields: [post_id], references: [post_id], onDelete: Cascade)
  tags    tags  @relation(fields: [tag_id], references: [tag_id], onDelete: Cascade)

  @@id([post_id, tag_id])
}
